# API base URL (defaults to /api/v1 via Vite proxy)
VITE_API_BASE_URL=/api/v1

# Optional: override to point directly to backend in staging/prod
# VITE_API_BASE_URL=https://api.tu-dominio.com/api/v1

# OAuth2 (django-oauth-toolkit)
VITE_OAUTH_CLIENT_ID=
VITE_OAUTH_SCOPE=read write
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/portal/oauth/callback
VITE_OAUTH_AUTHORIZE_URL=/api/v1/oauth/authorize/
VITE_OAUTH_TOKEN_URL=/api/v1/oauth/token/
VITE_OAUTH_REVOKE_URL=/api/v1/oauth/revoke_token/
